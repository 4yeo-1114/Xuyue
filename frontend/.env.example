# Supabase 配置（打包 exe 前必须：复制本文件为 .env 并填入真实值，否则班级等数据无法加载）
# 在 Supabase 控制台：Project Settings -> API 可查看 URL 和 anon key
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# 以下为可选，开发时无需配置
# VITE_API_BASE_URL 开发时默认 http://localhost:8081
# 打包 exe 时 .env.production 已设置 VITE_USE_RELATIVE_API=true，API 使用相对路径（同源）
