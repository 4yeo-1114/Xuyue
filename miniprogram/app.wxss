/* 全局样式 */

page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
}

/* ── 卡片 ── */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── 表单 ── */
.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #646a73;
  font-size: 28rpx;
}

.field-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
  height: 92rpx;
  line-height: 92rpx;
}

.field-placeholder {
  color: #b0b6bf;
}

.field-arrow::after {
  content: "›";
  color: #c0c4cc;
  font-size: 36rpx;
  margin-left: 8rpx;
}

/* 多行输入 */
.textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2329;
  padding: 12rpx 0;
  box-sizing: border-box;
}

/* ── 按钮 ── */
/*
 * 微信原生 button 自带 line-height: 2.55、左右 padding 和 ::after 边框覆盖层。
 * 只靠「height = line-height」撑高度，中文在行盒里视觉上会偏下；
 * 这里改成 flex 真正垂直居中，并把原生默认样式全部压掉。
 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0;
  line-height: 1.2;
  margin: 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  background: #2f6bff;
  color: #fff;
  border: none;
}

.btn::after {
  border: none;
}

.btn[disabled] {
  background: #c4cddb;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #2f6bff;
  border: 2rpx solid #2f6bff;
}

.btn-plain {
  background: #fff;
  color: #646a73;
  border: 2rpx solid #e5e6eb;
}

.btn-bottom {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

/* ── 状态标签 ── */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}

.tag-draft {
  background: #f2f4f7;
  color: #646a73;
}

.tag-pending {
  background: #fff4e6;
  color: #d97706;
}

.tag-printing {
  background: #e8f0ff;
  color: #2f6bff;
}

.tag-done {
  background: #e7f7ee;
  color: #12a150;
}

.tag-failed {
  background: #fdecec;
  color: #e5484d;
}

/* ── 空态 ── */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #9aa0a8;
  font-size: 28rpx;
}

.empty-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

/* ── 提示条 ── */
.hint {
  background: #eef4ff;
  color: #3559b8;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.hint-warn {
  background: #fff8e6;
  color: #96631a;
}

.muted {
  color: #9aa0a8;
  font-size: 24rpx;
}
