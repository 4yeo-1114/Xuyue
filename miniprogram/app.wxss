/* 全局样式 · 卡通软萌风 */

page {
  background: #f7f4ff;
  font-size: 28rpx;
  color: #4a3f5c;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
}

/* ── 软萌小动画 ── */
@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes pop-in {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* ── 卡片 ── */
.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 107, 255, 0.08);
  animation: pop-in 0.25s ease-out;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a3f5c;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── 表单 ── */
.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f0ecff;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #7d6f99;
  font-size: 28rpx;
}

.field-value {
  flex: 1;
  font-size: 28rpx;
  color: #4a3f5c;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #4a3f5c;
  height: 92rpx;
  line-height: 92rpx;
}

.field-placeholder {
  color: #c9bfe0;
}

.field-arrow::after {
  content: "›";
  color: #c9bfe0;
  font-size: 36rpx;
  margin-left: 8rpx;
}

/* 多行输入 */
.textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4a3f5c;
  padding: 12rpx 0;
  box-sizing: border-box;
}

/* ── 按钮（糖果胶囊） ── */
/*
 * 微信原生 button 自带 line-height: 2.55、左右 padding 和 ::after 边框覆盖层。
 * 只靠「height = line-height」撑高度，中文在行盒里视觉上会偏下；
 * 这里改成 flex 真正垂直居中，并把原生默认样式全部压掉。
 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 32rpx;
  line-height: 1.2;
  margin: 0;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  background: linear-gradient(135deg, #8e7cff, #6c8cff);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(124, 107, 255, 0.30);
}

.btn::after {
  border: none;
}

.btn[disabled] {
  background: #cfc5e6;
  color: #fff;
  box-shadow: none;
}

.btn-ghost {
  background: #fff;
  color: #7c6bff;
  border: 2rpx solid #c9bfe0;
  box-shadow: none;
}

.btn-plain {
  background: #fff;
  color: #7d6f99;
  border: 2rpx solid #e6dff2;
  box-shadow: none;
}

.btn-bottom {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

/* ── 状态标签 ── */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-draft {
  background: #f3effa;
  color: #7d6f99;
}

.tag-pending {
  background: #fff3d9;
  color: #e0870f;
}

.tag-printing {
  background: #efeaff;
  color: #7c6bff;
}

.tag-done {
  background: #e2f8ef;
  color: #1fb384;
}

.tag-failed {
  background: #ffe4ea;
  color: #f2647c;
}

/* ── 空态 ── */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #a89bc4;
  font-size: 28rpx;
}

.empty-emoji {
  font-size: 88rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: floaty 2.6s ease-in-out infinite;
}

/* ── 提示条 ── */
.hint {
  background: #efeaff;
  color: #6a56c8;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.hint-warn {
  background: #fff3d9;
  color: #96631a;
}

.muted {
  color: #a89bc4;
  font-size: 24rpx;
}
