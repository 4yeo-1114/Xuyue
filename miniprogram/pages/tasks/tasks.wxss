/* 靶向提升任务清单 */

.progress-bar {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(74, 63, 92, 0.05);
}

.progress-text {
  font-size: 26rpx;
  color: #7d6f99;
  margin-bottom: 14rpx;
}

.progress-track {
  height: 16rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #1fb384;
  border-radius: 999rpx;
}

/* ── 任务条目 ── */
.task-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.task-done .task-text {
  color: #a89bc4;
  text-decoration: line-through;
}

.task-check {
  padding-top: 4rpx;
}

.task-check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 3rpx solid #c9bfe0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.task-check-box.checked {
  background: #1fb384;
  border-color: #1fb384;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-text {
  font-size: 28rpx;
  color: #4a3f5c;
  line-height: 1.6;
}

.task-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.task-tag {
  font-size: 22rpx;
  color: #7c6bff;
  background: #efeaff;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
