/* 知识图谱 */

.unit-sub {
  font-size: 22rpx;
  color: #a89bc4;
  font-weight: 400;
}

.kp-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3effa;
}

.kp-row:last-child {
  border-bottom: none;
}

.kp-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.kp-code {
  font-size: 22rpx;
  color: #7c6bff;
  background: #efeaff;
  padding: 2rpx 12rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.kp-name {
  font-size: 28rpx;
  color: #4a3f5c;
  font-weight: 500;
  flex: 1;
}

.kp-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.kp-tag-key {
  background: #fff3d9;
  color: #e0870f;
}

.kp-tag-weak {
  background: #ffe4ea;
  color: #f2647c;
}

.kp-meter {
  height: 12rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 12rpx 0 8rpx;
}

.kp-meter-fill {
  height: 100%;
  background: #7c6bff;
  border-radius: 999rpx;
}

.kp-fill-weak {
  background: #f2647c;
}

.kp-meta {
  font-size: 22rpx;
  color: #a89bc4;
}

/* 点击反馈 + 箭头 */
.kp-row {
  transition: transform 0.12s ease;
}

.kp-row:active {
  transform: scale(0.98);
  background: #faf8ff;
  border-radius: 16rpx;
}

.kp-arrow {
  font-size: 36rpx;
  color: #cfc5e6;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 4rpx;
}

/* ── 空态初始化按钮 ── */
.init-btn {
  margin-top: 28rpx;
  width: 320rpx;
}

.empty .hint {
  margin-top: 20rpx;
  font-size: 20rpx;
}

/* ── 知识点详情弹层 ── */
.detail-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 63, 92, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.detail-box {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(124, 107, 255, 0.25);
  animation: pop-in 0.22s ease-out;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3f5c;
  margin-bottom: 18rpx;
}

.detail-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.detail-chip {
  font-size: 20rpx;
  color: #7c6bff;
  background: #efeaff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.detail-meter {
  height: 14rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.detail-meter-fill {
  height: 100%;
  background: #7c6bff;
  border-radius: 999rpx;
}

.detail-meta {
  font-size: 22rpx;
  color: #a89bc4;
  margin-bottom: 8rpx;
}

.detail-sec {
  margin-top: 22rpx;
  background: #f7f4ff;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.detail-sec-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #7c6bff;
  margin-bottom: 8rpx;
}

.detail-sec-body {
  font-size: 24rpx;
  color: #4a3f5c;
  line-height: 1.6;
  word-break: break-all;
}

.detail-close {
  margin-top: 28rpx;
}
