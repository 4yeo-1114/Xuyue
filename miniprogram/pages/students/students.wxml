<view class="page">

  <!-- 年级 / 班级 / 学科 -->
  <picker mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" bindchange="onGradeChange">
    <view class="card field">
      <text class="field-label">年级</text>
      <view class="field-value field-arrow">{{gradeLabels[gradeIndex] || '请选择年级'}}</view>
    </view>
  </picker>

  <picker mode="selector" range="{{classLabels}}" value="{{classIndex}}" bindchange="onClassChange">
    <view class="card field">
      <text class="field-label">班级</text>
      <view class="field-value field-arrow">{{classLabels[classIndex] || '请选择班级'}}</view>
    </view>
  </picker>

  <picker mode="selector" range="{{subjectLabels}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
    <view class="card field">
      <text class="field-label">学科</text>
      <view class="field-value field-arrow">{{subjectLabels[subjectIndex]}}</view>
    </view>
  </picker>

  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{students.length === 0}}" class="empty">
    <text class="empty-emoji">👥</text>
    该班级还没有学生
  </view>

  <block wx:else>
    <view class="hint">点学生名，看成绩走势 · 错题 · 预警</view>

    <view class="card stu-card" wx:for="{{students}}" wx:key="id">
      <view class="stu-head" data-name="{{item.name}}" bindtap="onToggleStudent">
        <view class="stu-name">{{item.name}}</view>
        <view class="stu-meta">
          <text class="tag" wx:if="{{item.tier}}">{{item.tier}} 层</text>
          <text class="stu-no">{{item.student_number}}</text>
        </view>
        <view class="stu-arrow">{{openName === item.name ? '⌃' : '⌄'}}</view>
      </view>

      <!-- 展开档案 -->
      <block wx:if="{{openName === item.name}}">
        <view wx:if="{{profileLoading}}" class="muted">正在加载档案…</view>
        <block wx:elif="{{profile}}">

          <!-- 趋势预警 -->
          <block wx:if="{{profile.alerts.length}}">
            <view class="alert-row" wx:for="{{profile.alerts}}" wx:for-item="al" wx:key="text">
              <text class="alert-tag {{al.level}}">{{al.levelLabel}}</text>
              <text class="alert-text">{{al.text}}</text>
            </view>
          </block>

          <!-- 成绩走势 -->
          <view class="sec-title">成绩走势 · {{subjectLabels[subjectIndex]}}</view>
          <view wx:if="{{profile.history.length === 0}}" class="muted">暂无成绩记录</view>
          <view class="h-row" wx:for="{{profile.history}}" wx:for-item="h" wx:key="exam">
            <view class="h-exam">{{h.exam}}</view>
            <view class="h-bars">
              <view class="h-line">
                <view class="h-track"><view class="h-fill h-fill-self" style="width: {{h.scorePct}}%"></view></view>
                <text class="h-val">{{h.score}}</text>
              </view>
              <view class="h-line">
                <view class="h-track"><view class="h-fill h-fill-avg" style="width: {{h.avgPct}}%"></view></view>
                <text class="h-val">{{h.avg}}</text>
              </view>
            </view>
            <view class="h-up">{{h.up}}</view>
          </view>
          <view class="legend">
            <view class="legend-item"><view class="legend-dot legend-dot-self"></view>个人分</view>
            <view class="legend-item"><view class="legend-dot legend-dot-avg"></view>班级均分</view>
          </view>

          <!-- 最近错题 -->
          <view class="sec-title">最近错题{{profile.wrongExam ? ' · ' + profile.wrongExam : ''}}</view>
          <view wx:if="{{profile.wrongs.length === 0}}" class="muted">暂无错题记录</view>
          <view class="wq-row" wx:for="{{profile.wrongs}}" wx:for-item="wq" wx:key="title">
            <view class="wq-title">{{wq.title}}</view>
            <view class="wq-kp" wx:if="{{wq.kp}}">知识点：{{wq.kp}}</view>
            <view class="wq-imgs" wx:if="{{wq.img || wq.ans}}">
              <image wx:if="{{wq.img}}" class="wq-img" src="{{wq.img}}" mode="aspectFill"
                data-url="{{wq.img}}" bindtap="onPreview"></image>
              <image wx:if="{{wq.ans}}" class="wq-img" src="{{wq.ans}}" mode="aspectFill"
                data-url="{{wq.ans}}" bindtap="onPreview"></image>
            </view>
          </view>

        </block>
      </block>
    </view>
  </block>

</view>
