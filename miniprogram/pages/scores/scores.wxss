/* 成绩单 + 能力雷达 */

/* ── tab 切换 ── */
.seg {
  display: flex;
  background: #f0ecff;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #7d6f99;
  border-radius: 22rpx;
}

.seg-on {
  background: #fff;
  color: #7c6bff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(74, 63, 92, 0.08);
}

/* ── 成绩单列表 ── */
.exam-item {
  padding: 0;
  overflow: hidden;
}

.exam-head {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.exam-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #4a3f5c;
}

.exam-meta {
  font-size: 24rpx;
  color: #a89bc4;
  margin-right: 16rpx;
}

.exam-arrow {
  color: #c9bfe0;
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.exam-body {
  border-top: 1rpx solid #f0ecff;
  padding: 20rpx 28rpx 28rpx;
}

/* 每生一行：名字 + 进度条 + 分数 */
.score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.score-name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4a3f5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-meter-wrap {
  flex: 1;
}

.score-meter {
  height: 16rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
}

.score-meter-fill {
  height: 100%;
  background: #7c6bff;
  border-radius: 999rpx;
}

.score-val {
  width: 120rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a3f5c;
}

.score-max {
  font-size: 22rpx;
  font-weight: 400;
  color: #a89bc4;
}

/* ── 六维能力对比条 ── */
.legend {
  display: flex;
  gap: 28rpx;
  margin-bottom: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #7d6f99;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.legend-dot-self {
  background: #7c6bff;
}

.legend-dot-avg {
  background: #e89b1c;
}

.dim {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3effa;
}

.dim:last-child {
  border-bottom: none;
}

.dim-name {
  font-size: 26rpx;
  color: #7d6f99;
  margin-bottom: 10rpx;
}

.dim-bars {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dim-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dim-track {
  flex: 1;
  height: 14rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 999rpx;
}

.dim-fill-self {
  background: #7c6bff;
}

.dim-fill-avg {
  background: #e89b1c;
}

.dim-val {
  width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  color: #4a3f5c;
}
