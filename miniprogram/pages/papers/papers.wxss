.papers-page {
  padding: 24rpx;
}

.papers-head {
  margin-bottom: 24rpx;
}

.papers-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4a3f5c;
}

.papers-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7d6f99;
}

.papers-error {
  margin-bottom: 16rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #ffe4ea;
  color: #f2647c;
  font-size: 24rpx;
}

.papers-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a89bc4;
}

.papers-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.papers-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.papers-card-main {
  flex: 1;
  min-width: 0;
}

.papers-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #4a3f5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.papers-card-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d6f99;
}

.papers-card-actions {
  flex-shrink: 0;
}

.papers-btn {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #7c6bff;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 2.1;
}

.papers-btn::after {
  border: none;
}
