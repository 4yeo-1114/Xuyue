.register-page {
  padding: 0 48rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #efeaff 0%, #f7f4ff 40%, #fff7f2 100%);
}

.brand {
  padding: 88rpx 0 56rpx;
  text-align: center;
}

.brand-logo {
  width: 152rpx;
  height: 152rpx;
  line-height: 152rpx;
  margin: 0 auto 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff9a8b, #ff6b8b);
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(255, 107, 139, 0.32);
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #4a3f5c;
}

.brand-sub {
  font-size: 26rpx;
  color: #a89bc4;
  margin-top: 14rpx;
}

.form-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(124, 107, 255, 0.10);
}

.code-btn {
  margin: 0 0 0 16rpx;
  padding: 0;
  width: 216rpx;
  min-width: 216rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 20rpx;
  background: #efeaff;
  color: #7c6bff;
  flex-shrink: 0;
}

.code-btn--off {
  color: #a89bc4;
}

.picker-value {
  font-size: 30rpx;
  color: #4a3f5c;
  padding: 24rpx 0;
}

.picker-placeholder {
  color: #b8b0cc;
}

.register-btn {
  margin-top: 56rpx;
}

.login-link {
  text-align: center;
  color: #a89bc4;
  font-size: 26rpx;
  margin-top: 32rpx;
}

.login-link .link {
  color: #7c6bff;
  font-weight: 600;
}
