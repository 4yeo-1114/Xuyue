.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.topbar-title {
  font-size: 40rpx;
  font-weight: 600;
}

.topbar-actions {
  display: flex;
  align-items: center;
}

.topbar-link {
  font-size: 26rpx;
  color: #2f6bff;
  margin-left: 28rpx;
}

/* 排版提示 */
.layout-hint {
  font-size: 23rpx;
  color: #2f6bff;
  background: #eef4ff;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  margin: 4rpx 0 8rpx;
}

/* ── 分段选择 ── */
.segmented {
  display: flex;
  background: #f2f4f7;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.segmented-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #646a73;
  padding: 18rpx 0;
  border-radius: 10rpx;
}

.segmented-3 .segmented-item {
  font-size: 25rpx;
  padding: 18rpx 4rpx;
}

.segmented-item-active {
  background: #fff;
  color: #2f6bff;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

/* ── 数字步进器 ── */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f2f4f7;
  color: #1f2329;
  font-size: 36rpx;
}

.stepper-input {
  width: 110rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 0 10rpx;
}

/* ── AI 题型列表 ── */
.type-head {
  font-size: 26rpx;
  color: #9aa0a8;
  margin: 24rpx 0 8rpx;
}

.type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f2f4f7;
}

.type-row:last-child {
  border-bottom: none;
}

.type-label {
  font-size: 28rpx;
  color: #1f2329;
}

/* ── 上传 ── */
.upload-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  border: 2rpx dashed #c9d3e6;
  border-radius: 16rpx;
  color: #2f6bff;
  font-size: 26rpx;
  background: #f8fbff;
}

.upload-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.upload-tip {
  color: #9aa0a8;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}

.upload-status {
  margin-top: 16rpx;
}

.upload-list {
  margin-top: 18rpx;
}

.upload-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.upload-item-main {
  flex: 1;
  min-width: 0;
}

.upload-name {
  display: block;
  font-size: 26rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-meta {
  display: block;
  font-size: 22rpx;
  color: #9aa0a8;
  margin-top: 6rpx;
}

.upload-remove {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: #9aa0a8;
  font-size: 30rpx;
  flex-shrink: 0;
}
