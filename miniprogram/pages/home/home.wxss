/* 主页门户 · 卡通软萌风 */

.home-page {
  padding-top: 24rpx;
}

/* ── 顶部糖果横幅 ── */
.home-head {
  padding: 48rpx 40rpx 44rpx;
  background: linear-gradient(135deg, #8e7cff, #6c8cff);
  border-radius: 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(124, 107, 255, 0.28);
}

.home-head-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.home-logo {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 56rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 32rpx;
  flex-shrink: 0;
  animation: floaty 3s ease-in-out infinite;
}

.home-brand {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.home-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 14rpx;
}

/* ── 我的名片 ── */
.mine-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 107, 255, 0.08);
  animation: pop-in 0.25s ease-out;
}

.mine-card:active {
  transform: scale(0.98);
}

.mine-arrow {
  font-size: 44rpx;
  color: #cfc5e6;
  font-weight: 700;
  flex-shrink: 0;
}

.mine-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 22rpx;
}

.mine-avatar {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 52rpx;
  background: #efeaff;
  border-radius: 32rpx;
  flex-shrink: 0;
  animation: floaty 3.2s ease-in-out infinite;
}

.mine-info {
  flex: 1;
  min-width: 0;
}

.mine-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a3f5c;
  margin-bottom: 10rpx;
}

.mine-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mine-chip {
  font-size: 20rpx;
  color: #7c6bff;
  background: #efeaff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.mine-stats {
  display: flex;
  background: #f7f4ff;
  border-radius: 24rpx;
  padding: 20rpx 0;
}

.mine-stat {
  flex: 1;
  text-align: center;
}

.mine-stat:active {
  transform: scale(0.92);
}

.mine-num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.mine-num-purple { color: #7c6bff; }
.mine-num-mint   { color: #1fb384; }
.mine-num-pink   { color: #ff6b8b; }

.mine-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a89bc4;
}

/* ── 两大功能卡片 ── */
.home-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.home-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 120, 160, 0.18);
  animation: pop-in 0.3s ease-out;
}

.home-card:active {
  transform: scale(0.96);
}

.home-card-primary {
  background: linear-gradient(150deg, #ff9a8b, #ff6b8b);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 139, 0.30);
}

.home-card-accent {
  background: linear-gradient(150deg, #4ecdc4, #38b6c9);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(62, 196, 188, 0.30);
}

.home-card-icon {
  font-size: 56rpx;
  margin-bottom: 20rpx;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 32rpx;
  animation: floaty 2.8s ease-in-out infinite;
}

.home-card-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.home-card-desc {
  font-size: 22rpx;
  opacity: 0.92;
  line-height: 1.5;
}

/* ── 最近批改流 ── */
.recent-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 107, 255, 0.08);
  animation: pop-in 0.3s ease-out;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a3f5c;
}

.recent-more {
  font-size: 22rpx;
  color: #7c6bff;
  padding: 6rpx 12rpx;
}

.recent-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid #f3f0fb;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-row:active {
  background: #f7f4ff;
  border-radius: 16rpx;
}

.recent-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-done    { background: #1fb384; }
.dot-failed  { background: #ff6b8b; }
.dot-pending { background: #f5b83d; }

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-name {
  font-size: 26rpx;
  color: #4a3f5c;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a89bc4;
}

.recent-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.tag-done    { background: #e2f8ef; color: #1fb384; }
.tag-failed  { background: #ffe4ea; color: #ff6b8b; }
.tag-pending { background: #fff3d9; color: #d99a1f; }
