/* 改分台账 */

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  background: #7c6bff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
}

/* ── 分类 chips ── */
.chips {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #7d6f99;
  font-size: 24rpx;
  border: 1rpx solid #e6dff2;
}

.chip-on {
  background: #7c6bff;
  color: #fff;
  border-color: #7c6bff;
}

/* ── 台账行 ── */
.ledger-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ledger-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a3f5c;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.ledger-change {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.ledger-q {
  font-size: 24rpx;
  color: #a89bc4;
}

.ledger-diff {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.ledger-was {
  color: #a89bc4;
  text-decoration: line-through;
}

.ledger-arrow {
  color: #c9bfe0;
}

.ledger-new {
  color: #4a3f5c;
  font-weight: 600;
}

.ledger-comment {
  font-size: 24rpx;
  color: #7d6f99;
  background: #f7f4ff;
  border-radius: 22rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.ledger-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #a89bc4;
}

.ledger-voided {
  color: #f2647c;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
}
