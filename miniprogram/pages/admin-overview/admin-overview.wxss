/* 账号总览 · 卡通软萌风 */

.admin-page {
  padding-top: 24rpx;
}

.admin-retry {
  display: block;
  width: fit-content;
  margin: 28rpx auto 0;
  background: #7c6bff;
  color: #fff;
  font-size: 24rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
}

.admin-retry:active {
  transform: scale(0.95);
}

/* ── 顶部横幅 ── */
.admin-hero {
  padding: 44rpx 40rpx;
  background: linear-gradient(135deg, #8e7cff, #ff6b8b);
  border-radius: 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(142, 124, 255, 0.28);
  animation: pop-in 0.25s ease-out;
}

.admin-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.admin-hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

/* ── 汇总四宫格 ── */
.admin-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.admin-stat {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 6rpx 22rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(124, 107, 255, 0.08);
  animation: pop-in 0.3s ease-out;
}

.admin-stat-num {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.num-purple { color: #7c6bff; }
.num-mint   { color: #1fb384; }
.num-pink   { color: #ff6b8b; }
.num-blue   { color: #38b6c9; }

.admin-stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a89bc4;
}

/* ── 文件夹分组 ── */
.admin-group {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 107, 255, 0.08);
  animation: pop-in 0.3s ease-out;
}

.admin-group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.admin-group-icon {
  font-size: 30rpx;
}

.admin-group-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #4a3f5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-group-count {
  background: #efeaff;
  color: #7c6bff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ── 账号行 ── */
.admin-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid #f3f0fb;
}

.admin-row:last-child {
  border-bottom: none;
}

.admin-row-main {
  flex: 1;
  min-width: 0;
}

.admin-row-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #4a3f5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-row-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a89bc4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-row-side {
  flex-shrink: 0;
  text-align: right;
}

.admin-row-grade {
  font-size: 22rpx;
  color: #7c6bff;
  font-weight: 500;
}

.admin-row-balance {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #1fb384;
  font-weight: 700;
}

/* ── 脚注 ── */
.admin-foot {
  text-align: center;
  color: #a89bc4;
  font-size: 20rpx;
  padding: 8rpx 0 24rpx;
}
