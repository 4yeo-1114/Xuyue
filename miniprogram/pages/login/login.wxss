.login-page {
  padding: 0 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #fff;
}

.brand {
  padding: 140rpx 0 80rpx;
  text-align: center;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2f6bff, #5b8cff);
  color: #fff;
  font-size: 64rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(47, 107, 255, 0.28);
}

.brand-name {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: #9aa0a8;
  margin-top: 12rpx;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.login-btn {
  margin-top: 56rpx;
}

.login-tip {
  text-align: center;
  color: #9aa0a8;
  font-size: 24rpx;
  margin-top: 32rpx;
}
