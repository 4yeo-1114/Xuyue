/* 批改作业页 */

/* ── 上传 ── */
.grade-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  border: 2rpx dashed #c9bfe0;
  border-radius: 32rpx;
  background: #fbf8ff;
}

/* 标准答案卷上传区，次要入口，矮一点 */
.grade-upload-mini {
  height: 200rpx;
}

.grade-upload-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.grade-upload-text {
  font-size: 28rpx;
  color: #7c6bff;
}

.preview-wrap {
  margin-top: 8rpx;
}

.preview-img {
  width: 100%;
  border-radius: 22rpx;
  background: #f3effa;
}

.preview-tip {
  text-align: center;
  color: #a89bc4;
  font-size: 23rpx;
  margin-top: 12rpx;
}

/* ── 批改进度 ── */
.grading-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.grading-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.grading-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4a3f5c;
  margin-bottom: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: #7c6bff;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* ── 结果图片切换 ── */
.img-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.img-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f3effa;
  color: #7d6f99;
  font-size: 26rpx;
}

.img-tab-active {
  background: #7c6bff;
  color: #fff;
}

.result-img {
  width: 100%;
  height: 100%;
}

/* ── 图片查看器（可放大缩小拖动）── */
.img-viewport {
  width: 100%;
  height: 60vh;
  background: #2d2440;
  border-radius: 22rpx;
  overflow: hidden;
}

.img-movable {
  width: 100%;
  height: 100%;
}

.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.zoom-btn {
  min-width: 76rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  background: #f0ecff;
  border-radius: 999rpx;
}

.zoom-btn-disabled {
  color: #c9bfe0;
  background: #f7f4ff;
}

.zoom-label {
  min-width: 96rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7d6f99;
}

/* ── 批改明细 ── */
.result-text {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0ecff;
}

.result-text-title {
  font-size: 26rpx;
  color: #7d6f99;
  margin-bottom: 12rpx;
}

.result-text-body {
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a3f5c;
}

/* 汇总 chips */
.q-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.q-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f3effa;
  color: #7d6f99;
}

.q-chip-ok { background: #e6f7ee; color: #1f9d63; }
.q-chip-bad { background: #fdecec; color: #d64545; }
.q-chip-half { background: #fff3e0; color: #d98324; }
.q-chip-blank { background: #f0ecff; color: #7c6bff; }
.q-chip-muted { background: #f3effa; color: #9a8fb8; }

/* 一题一卡（点开看答案与解析） */
.q-card {
  background: #fbf9ff;
  border: 2rpx solid #eee8fb;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  transition: border-color 0.2s ease;
}

.q-card-open {
  border-color: #c9bfe0;
  background: #fff;
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.q-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #3d3352;
}

.q-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.q-score {
  font-size: 24rpx;
  color: #7c6bff;
}

.q-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.q-badge-ok { background: #e6f7ee; color: #1f9d63; }
.q-badge-bad { background: #fdecec; color: #d64545; }
.q-badge-half { background: #fff3e0; color: #d98324; }
.q-badge-blank { background: #f0ecff; color: #7c6bff; }
.q-badge-muted { background: #f3effa; color: #9a8fb8; }
.q-badge-warn { background: #fff8d6; color: #b58a12; }

.q-preview {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8a7fa6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.q-body {
  margin-top: 18rpx;
  border-top: 1rpx dashed #eee8fb;
  padding-top: 16rpx;
}

.q-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 12rpx;
  align-items: flex-start;
}

.q-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 24rpx;
  color: #a89bc4;
  padding-top: 2rpx;
}

.q-value {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.65;
  color: #4a3f5c;
  white-space: pre-line;
  word-break: break-all;
}

.q-anno {
  color: #d64545;
}

.q-correct {
  color: #1f9d63;
  font-weight: 600;
}

.q-subs {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: #f7f4ff;
  border-radius: 16rpx;
}

.q-sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.q-sub-title {
  font-size: 24rpx;
  color: #7d6f99;
}

.q-arrow {
  margin-top: 14rpx;
  text-align: center;
  font-size: 23rpx;
  color: #a89bc4;
}

.variant-btn {
  margin-top: 8rpx;
}

/* ── 底部操作按钮 ── */
.action-btn {
  margin-top: 24rpx;
}
