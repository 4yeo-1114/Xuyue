.result-card {
  text-align: center;
  padding: 44rpx 28rpx 36rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

.status-wrap {
  margin-bottom: 20rpx;
}

.status-wrap .tag {
  font-size: 28rpx;
  padding: 14rpx 30rpx;
}

.result-meta {
  color: #7d6f99;
  font-size: 25rpx;
}

.status-sub {
  margin-top: 18rpx;
  color: #7d6f99;
  font-size: 26rpx;
  line-height: 1.6;
}

.result-printer {
  margin-top: 16rpx;
  color: #a89bc4;
  font-size: 24rpx;
}

.action-btn {
  margin-bottom: 22rpx;
}

/* 大按钮只放大高度和字号；垂直居中由 .btn 的 flex 负责，不要再用 line-height 撑 */
.action-btn.big {
  height: 100rpx;
  font-size: 34rpx;
}
