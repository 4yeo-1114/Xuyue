# ============================================================
# 叙阅后端 .env 示例（复制为 .env 后填写真实值）
# 安全约定：
#   - 生产环境的 DB_PASSWORD / JWT_SECRET_KEY / SMTP_PASSWORD / BAIDU_ACCESS_TOKEN
#     绝不要写入版本库；部署时通过环境变量或密钥管理服务注入。
#   - multi_project_settings.json 中的 db profile 密码可用 env:VAR_NAME 形式引用环境变量。
#   - 本文件只作为字段清单，提交到 git 是安全的；真实 .env 已被 .gitignore 忽略。
#   - 环境分离：本地开发用 .env，DB_* 留空即 fail-closed（启动报"缺少必要配置"，
#     宁可起不来也不连生产库；需要本地调试时填开发库）；生产凭据放 .env.production
#     （已 gitignore，仅供部署流程使用），生产环境通过环境变量/密钥管理注入。
# ============================================================

# MySQL（阿里云 RDS 等，部署时在 .env 中填写）
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=grade

# JWT 签名密钥（必填，>=32 字符，未配置会启动失败）
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# 启动是否自动执行建库/DDL（生产必须为 false，改为手动迁移）
AUTO_DDL=false

# 默认监听地址（L2：默认 127.0.0.1，避免直接暴露到局域网/公网）
HOST=127.0.0.1

# CORS 严格白名单（逗号分隔；配置后仅允许这些来源跨域）
ALLOWED_CORS_ORIGINS=

# 多项目超管邮箱（H5：逗号分隔多个邮箱，不再硬编码）
MULTI_PROJECT_ADMIN_EMAILS=

# 文件下载票有效期（分钟，H2）
DOWNLOAD_TICKET_EXPIRE_MINUTES=120

# 每个账号每日邮件发送上限（H4 限流）
EMAIL_DAILY_LIMIT=20

# 钉钉（免登 + 通讯录同步 + 统分完成工作通知）：corpId / AppKey / AppSecret / AgentId
# 留空 = 钉钉免登与通讯录同步不可用；通讯录同步还需在开放平台开通「通讯录」读权限
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# 钉钉工作通知的报告链接跳转地址（前端公网 https base，如 https://foil.6108.net）
DINGTALK_FRONTEND_BASE_URL=

# 百度智能作业批改（correct_edu）：提交 2QPS、获取结果 2QPS、后台约 4 并发
BAIDU_ACCESS_TOKEN=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_CREATE_QPS=2
BAIDU_GET_RESULT_QPS=2
BAIDU_BACKEND_CONCURRENCY=4
BAIDU_RESULT_INITIAL_WAIT=5
BAIDU_RESULT_POLL_INTERVAL=0.5
BAIDU_GRADE_WORKERS=4

# SMTP（STARTTLS fail-closed，M7）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 定时任务访问密钥（调度端调用时校验）
CRON_KEY=

# DashScope（通义千问）AI 能力：为空则相关 AI 功能禁用
# 视觉（图片批改 qwen-vl-max）与语音识别（qwen3-asr）始终走 DashScope，不受下面 LLM_* 影响
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus

# 文本 LLM（OpenAI 兼容网关，可切换供应商，如 DeepSeek 等）
# 未配置时回退到上面的 DashScope（向后兼容）；配置后文本类 AI（评语/学情/助教/资源/试卷等）走该网关
LLM_BASE_URL=https://llmapi.xykjy.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

# 待办事项自动通知轮询（后台任务）
AUTO_TODO_NOTIFY_ENABLED=true
AUTO_TODO_NOTIFY_INTERVAL_SECONDS=30
